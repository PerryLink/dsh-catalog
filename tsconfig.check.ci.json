{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {}
  },
  "include": ["scripts/**/*.mjs", "deploy/**/*.js", "deploy/**/*.mjs"]
}
